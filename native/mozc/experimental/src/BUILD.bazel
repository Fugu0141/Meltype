load(
    "//:build_defs.bzl",
    "mozc_cc_binary",
    "mozc_cc_library",
    "mozc_cc_test",
)

mozc_cc_library(
    name = "responsibility_decoder",
    srcs = ["responsibility_decoder.cc"],
    hdrs = [
        "generated_lexicon.h",
        "responsibility_decoder.h",
    ],
)

mozc_cc_library(
    name = "responsibility_runtime",
    srcs = ["responsibility_runtime.cc"],
    hdrs = ["responsibility_runtime.h"],
    deps = [":responsibility_decoder"],
)

mozc_cc_library(
    name = "responsibility_ime_adapter",
    srcs = ["responsibility_ime_adapter.cc"],
    hdrs = ["responsibility_ime_adapter.h"],
    deps = [
        ":responsibility_runtime",
        "//client:client_interface",
        "//protocol:commands_cc_proto",
    ],
)

mozc_cc_library(
    name = "responsibility_tsf_router",
    srcs = ["responsibility_tsf_router.cc"],
    hdrs = ["responsibility_tsf_router.h"],
    deps = [
        ":responsibility_ime_adapter",
        ":responsibility_runtime",
        "//client:client_interface",
        "//protocol:commands_cc_proto",
        "//win32/base:keyboard",
    ],
)

mozc_cc_test(
    name = "responsibility_decoder_test",
    size = "small",
    srcs = ["responsibility_decoder_test.cc"],
    deps = [
        ":responsibility_decoder",
        "//testing:gunit_main",
    ],
)

mozc_cc_test(
    name = "responsibility_runtime_test",
    size = "small",
    srcs = ["responsibility_runtime_test.cc"],
    deps = [
        ":responsibility_runtime",
        "//testing:gunit_main",
    ],
)

# Integration harness: the responsibility runtime decides which bytes are owned
# by Mozc and which are literal, then the Japanese spans are replayed through a
# real Mozc client/session.  This is intentionally separate from the TSF DLL so
# boundary bugs can be reproduced from a console first.
mozc_cc_binary(
    name = "boundary_mozc_bridge",
    srcs = ["boundary_mozc_bridge.cc"],
    deps = [
        ":responsibility_runtime",
        "//base:init_mozc",
        "//base:system_util",
        "//client",
        "//protocol:commands_cc_proto",
    ],
)
