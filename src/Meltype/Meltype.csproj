<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Meltype</AssemblyName>
    <RootNamespace>Meltype</RootNamespace>
    <Version>1.0.2</Version>
    <Product>Meltype</Product>
    <Authors>Yukishiro</Authors>
    <Copyright>Copyright (C) 2026 雪代 / Yukishiro. GPL-3.0-or-later</Copyright>
    <Description>半角/全角 キーを押さなくても日本語と英語を打ち分けられるようにする常駐ツール</Description>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- WinRtCandidates で COM の関数表を直接呼ぶため -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Meltype.Tests" />
    <ProjectReference Include="..\Meltype.Core\Meltype.Core.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(OS)' == 'Windows_NT'">
    <Content Include="..\..\native\inputhook\bin\x64\Release\meltype_input_hook.dll"
             Link="meltype_input_hook.dll"
             Condition="Exists('..\..\native\inputhook\bin\x64\Release\meltype_input_hook.dll')"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>